# Copy to backend/.env (gitignored) and fill in. Never commit .env.
# Django refuses to start if DJANGO_SECRET_KEY is empty or under 32 chars.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Keep False except for throwaway local debugging.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL. docker-compose runs a "db" service from these three values.
# Change the password in BOTH POSTGRES_PASSWORD and DATABASE_URL (must match).
# If DATABASE_URL is empty, Django falls back to SQLite.
POSTGRES_DB=ecotracker
POSTGRES_USER=ecotracker
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ecotracker:change-me@db:5432/ecotracker
# Set True for hosted Postgres that requires SSL (not for the compose db).
DATABASE_SSL_REQUIRE=False

# Celery / Redis (docker-compose overrides these)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
