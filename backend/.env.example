# Copy to backend/.env (gitignored) and fill in. Never commit .env.
# Django refuses to start if DJANGO_SECRET_KEY is empty or under 32 chars.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Keep False except for throwaway local debugging.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: PostgreSQL URL (if unset, SQLite is used)
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Celery / Redis (docker-compose overrides these)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
